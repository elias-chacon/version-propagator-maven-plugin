root = true

[*]
charset = utf-8
indent_style = tab
end_of_line = crlf
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

[*.java]
ij_java_generate_final_locals = true
ij_java_generate_final_parameters = true

# ─────────────────────────────────────────
# IMPORTS
# ─────────────────────────────────────────

# Usa import por classe (não agrupa com *)
ij_java_use_single_class_imports = true

# Quantidade de classes antes de usar wildcard (*)
# 99 = quase nunca usa *, igual ao Eclipse
ij_java_class_count_to_use_import_on_demand = 99
ij_java_names_count_to_use_import_on_demand = 99

# Pacotes que sempre usam wildcard (padrão Eclipse)
ij_java_packages_to_use_import_on_demand = java.awt.*, javax.swing.*

# Imports estáticos separados
ij_java_layout_static_imports_separately = true

# Ordem dos imports (estilo Eclipse)
ij_java_imports_layout = $*, |, java.**, |, javax.**, |, org.**, |, com.**, |, *