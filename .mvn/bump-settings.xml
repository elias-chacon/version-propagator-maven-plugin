<?xml version="1.0" encoding="UTF-8"?>
<!--
	Maven settings used only for the version bump (profile "bump" of the parent POM):
		mvn -s .mvn/bump-settings.xml -Pbump propagate:bump -Dbump.part=patch

	- No mirror on purpose: a corporate mirror with mirrorOf="*" would redirect the "github" repository away
	  from GitHub Packages. The bump goal only needs the plugin, which comes from GitHub Packages.
	- GitHub Packages requires authentication even for public packages. Credentials come from the environment,
	  never from this file:
	    GITHUB_ACTOR  GitHub user name
	    GITHUB_TOKEN  token with the read:packages scope (in GitHub Actions: the workflow GITHUB_TOKEN)
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
		  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
	<interactiveMode>false</interactiveMode>
	<servers>
		<server>
			<id>github</id>
			<username>${env.GITHUB_ACTOR}</username>
			<password>${env.GITHUB_TOKEN}</password>
		</server>
	</servers>
</settings>
